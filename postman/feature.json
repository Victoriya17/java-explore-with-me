      "item": [
        {
          "name": "Удаление комментария администратором",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Комментарий успешно удален Администратором из базы данных (Статус 204)\", function () {\r",
                  "    pm.response.to.have.status(204);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const main = async () => {\r",
                  "    const api = new API(pm);\r",
                  "    const rnd = new RandomUtils();\r",
                  "\r",
                  "    let commentId; \r",
                  "    let authorId; \r",
                  "    try {\r",
                  "        const author = await api.addUser(rnd.getUser());\r",
                  "        authorId = author.id; \r",
                  "\r",
                  "        const initiator = await api.addUser(rnd.getUser());\r",
                  "        const category = await api.addCategory(rnd.getCategory());\r",
                  "        \r",
                  "        let createdEvent = await api.addEvent(initiator.id, rnd.getEvent(category.id));\r",
                  "        await api.publishEvent(createdEvent.id); \r",
                  "\r",
                  "        const commentData = rnd.getComment();\r",
                  "        commentData.eventId = createdEvent.id;\r",
                  "\r",
                  "        let comment = await api.post(\"/users/\" + author.id + \"/comments\", commentData, \"Ошибка создания комментария: \");\r",
                  "        commentId = comment.id;\r",
                  "\r",
                  "    } catch(err) {\r",
                  "        console.error(\"Ошибка при подготовке тестовых данных.\", err);\r",
                  "    }\r",
                  "\r",
                  "    pm.request.url.variables.upsert({ key: 'userId', value: authorId ? authorId.toString() : \"1\" });\r",
                  "    pm.request.url.variables.upsert({ key: 'comId', value: commentId ? commentId.toString() : \"1\" });\r",
                  "};\r",
                  "\r",
                  "const interval = setInterval(() => {}, 1000);\r",
                  "setTimeout(async () => {\r",
                  "    try { await main(); } catch (e) { console.error(e); } finally { clearInterval(interval); }\r",
                  "}, 100);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
