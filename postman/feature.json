          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Админ успешно получил отфильтрованные комментарии (Статус 200)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Ответ возвращает массив данных и находит слово\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.be.an('array');\r",
                  "    pm.expect(jsonData.length).to.be.at.most(5);\r",
                  "\r",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);\r",
                  "\r",
                  "    let firstCommentText = jsonData[0].text.toLowerCase();\r",
                  "    pm.expect(firstCommentText).to.include(\"великолепно\");\r",
                  "});"
