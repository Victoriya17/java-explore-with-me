  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "API = class {\r",
          "    constructor(postman, verbose = false, baseUrl = \"http://localhost:8080\") {\r",
          "        this.baseUrl = baseUrl;\r",
          "        this.pm = postman;\r",
          "        this._verbose = verbose;\r",
          "    }\r",
          "    async addUser(user) { return this.post(\"/admin/users\", user, \"Ошибка пользователя: \"); }\r",
          "    async addCategory(category) { return this.post(\"/admin/categories\", category, \"Ошибка категории: \"); }\r",
          "    async addEvent(userId, event) { return this.post(\"/users/\" + userId + \"/events\", event, \"Ошибка события: \"); }\r",
          "    async publishEvent(eventId) { return this.patch('/admin/events/' + eventId, {stateAction: \"PUBLISH_EVENT\"}, \"Ошибка публикации: \"); }\r",
          "    async addComment(userId, eventId, comment) { \r",
          "        const body = Object.assign({}, comment);\r",
          "        body.eventId = eventId;\r",
          "        return this.post(\"/users/\" + userId + \"/comments\", body, \"Ошибка создания комментария: \"); \r",
          "    }\r",
          "    \r",
          "    async post(path, body, errorText) { return this.sendRequest(\"POST\", path, body, errorText); }\r",
          "    async patch(path, body = null, errorText = \"Ошибка patch: \") { return this.sendRequest(\"PATCH\", path, body, errorText); }\r",
          "    async get(path, body = null, errorText = \"Ошибка get: \") { return this.sendRequest(\"GET\", path, body, errorText); }\r",
          "    \r",
          "    async sendRequest(method, path, body=null, errorText = \"Ошибка запроса: \") {\r",
          "        return new Promise((resolve, reject) => {\r",
          "            const request = {\r",
          "                url: this.baseUrl + path,\r",
          "                method: method,\r",
          "                body: body == null ? \"\" : JSON.stringify(body),\r",
          "                header: { \"Content-Type\": \"application/json\" },\r",
          "            };\r",
          "            this.pm.sendRequest(request, (error, response) => {\r",
          "                if(error || (response.code >= 400 && response.code <= 599)) reject(new Error(errorText));\r",
          "                else resolve(response.json());\r",
          "            });\r",
          "        });\r",
          "    }\r",
          "};\r",
          "\r",
          "RandomUtils = class {\r",
          "    constructor() {}\r",
          "    getUser() { return { name: pm.variables.replaceIn('{{$randomFullName}}'), email: pm.variables.replaceIn('{{$randomEmail}}') }; }\r",
          "    getCategory() { return { name: pm.variables.replaceIn('{{$randomWord}}') + Math.floor(Math.random() * 10000).toString() }; }\r",
          "    getEvent(categoryId) {\r",
          "        let moment = require('moment');\r",
          "        return {\r",
          "            annotation: \"Краткое описание события длиной более двадцати символов\",\r",
          "            category: categoryId,\r",
          "            description: \"Полное подробное описание мероприятия для прохождения валидации\",\r",
          "            eventDate: moment().add(1, 'years').format('YYYY-MM-DD HH:mm:ss'), // Дата через год для Docker\r",
          "            location: { lat: 55.7558, lon: 37.6173 },\r",
          "            title: \"Случайное событие \" + Math.floor(Math.random() * 1000)\r",
          "        };\r",
          "    }\r",
          "    getComment() { return { text: pm.variables.replaceIn('{{$randomLoremSentence}}') }; }\r",
          "};"
        ]
      }
    },
