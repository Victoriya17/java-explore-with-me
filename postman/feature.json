                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "async function run() {\r",
                  "    const api = new API(pm);\r",
                  "    const rand = new RandomUtils();\r",
                  "    \r",
                  "    const user = await api.addUser(rand.getUser());\r",
                  "    const cat = await api.addCategory(rand.getCategory());\r",
                  "    const ev = await api.addEvent(user.id, rand.getEvent(cat.id));\r",
                  "    await api.publishEvent(ev.id);\r",
                  "    \r",
                  "    const commentBody = { text: \"великолепно\", eventId: ev.id };\r",
                  "    await api.post(\"/users/\" + user.id + \"/comments\", commentBody, \"Ошибка создания комментария: \"); \r",
                  "}\r",
                  "run();"
                ],
